# -*- mode: sh; sh-shell: bash; -*-
# init files are bash script

# Man-In-Grey.init
# --------------------------------------------------------------------------------
# Put Man-In-Grey's promoted library on PYTHONPATH, so the project's code can
# import Journal·Interface, Journal and Language.
#
# The link Man-In-Grey points at Man-In-Grey's consumer/. Only the composer
# side reads PYTHONPATH: the gate starts the guard and the interpreter with
# /usr/bin/python3 -E, which ignores it.
#
# Setup sources the init files in name order, so this file comes before
# Python.init and python3 is not yet the project's build here. The test is
# therefore for the file, not an import. The library imports cbor2, which the
# project's Python needs: python3 -m pip install cbor2

Man_In_Grey__dp="$REPO_HOME/shared/project-dependency/Man-In-Grey/Man_In_Grey"
if [[ ! -f "$Man_In_Grey__dp/Journal·Interface.py" ]]; then
  if [[ "$ROLE" == "administrator" ]]; then
    echo "Man-In-Grey.init: no $Man_In_Grey__dp/Journal·Interface.py; promote Man-In-Grey, or link its consumer/ here"
  fi
else
  case ":${PYTHONPATH:-}:" in
    *":$Man_In_Grey__dp:"*) ;;
    *) export PYTHONPATH="$Man_In_Grey__dp${PYTHONPATH:+:$PYTHONPATH}" ;;
  esac
fi
unset Man_In_Grey__dp