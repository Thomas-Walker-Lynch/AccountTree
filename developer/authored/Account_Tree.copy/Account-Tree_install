#!/usr/bin/env bash
# -*- mode: sh; indent-tabs-mode: nil; sh-basic-offset: 2 -*-
#
# Account-Tree_install
#
# Install Account-Tree from the directory this script is in, the project's
# consumer/Account_Tree, into /usr/local/lib/Account-Tree, where only root can
# change it. The systemd units run Account-Tree_admin under root, so the copy
# they run must be one that no other account can change.
#
# The install directory is made to hold exactly the files of the consumer
# directory: new and changed files are copied, owned by root, and files the
# consumer directory no longer has are deleted. Python's __pycache__ is left
# out. Then system configure writes the units and the udev rule, so that they
# name the installed Account-Tree_admin.
#
# Run it under root. Whoever installs code that root runs can act as root, so
# installing is root's own work.

INSTALL_DIR=/usr/local/lib/Account-Tree

usage(){
  cat <<EOF
Usage: Account-Tree_install <command>
       Account-Tree_install preview <command>
  help | -h | --help    print this message (also printed when given no arguments)
  run                   install from $(source_dir) into $INSTALL_DIR,
                        then run Account-Tree_admin system configure
  preview run           print what run would do, change nothing
EOF
}

source_dir(){
  cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")" && pwd
}

# the files to install, relative to the source dir, one per line
list__file(){
  ( cd "$1" && find . -name __pycache__ -prune -o -type f -print | sed 's|^\./||' | sort )
}

# mode for an installed file: programs 0755, everything else 0644
file_mode(){
  if [ -x "$1" ]; then echo 0755; else echo 0644; fi
}

install_tree(){
  local preview=$1 source=$2
  local count_of__new=0 count_of__replaced=0 count_of__deleted=0 count_of__unchanged=0
  local verb__made=made verb__new=installed verb__replaced=replaced verb__deleted=deleted
  if [ "$preview" = yes ]; then
    verb__made="would make" verb__new="would install" verb__replaced="would replace" verb__deleted="would delete"
  fi

  if [ ! -d "$INSTALL_DIR" ]; then
    printf '  %-16s%s\n' "$verb__made" "$INSTALL_DIR"
    [ "$preview" = yes ] || install -d -o root -g root -m 0755 "$INSTALL_DIR" || return 1
  fi

  local f mode
  while IFS= read -r f; do
    mode=$(file_mode "$source/$f")
    if [ ! -e "$INSTALL_DIR/$f" ]; then
      printf '  %-16s%s\n' "$verb__new" "$f"; count_of__new=$((count_of__new + 1))
    elif ! cmp -s "$source/$f" "$INSTALL_DIR/$f" || [ "$(stat -c %a "$INSTALL_DIR/$f")" != "${mode#0}" ] \
         || [ "$(stat -c %u:%g "$INSTALL_DIR/$f")" != 0:0 ]; then
      printf '  %-16s%s\n' "$verb__replaced" "$f"; count_of__replaced=$((count_of__replaced + 1))
    else
      count_of__unchanged=$((count_of__unchanged + 1)); continue
    fi
    if [ "$preview" != yes ]; then
      install -D -o root -g root -m "$mode" "$source/$f" "$INSTALL_DIR/$f" || return 1
    fi
  done < <(list__file "$source")

  # files the consumer directory no longer has
  [ -d "$INSTALL_DIR" ] && while IFS= read -r f; do
    if [ ! -e "$source/$f" ]; then
      printf '  %-16s%s\n' "$verb__deleted" "$f"; count_of__deleted=$((count_of__deleted + 1))
      [ "$preview" = yes ] || rm -f -- "$INSTALL_DIR/$f" || return 1
    fi
  done < <(list__file "$INSTALL_DIR")
  [ "$preview" = yes ] || find "$INSTALL_DIR" -mindepth 1 -type d -empty -delete

  echo "summary:"
  printf '  %4d  %s\n' "$count_of__new" "$verb__new" "$count_of__replaced" "$verb__replaced" \
         "$count_of__deleted" "$verb__deleted" "$count_of__unchanged" "unchanged"
}

CLI(){
  if [ $# -eq 0 ] || [ "$1" = help ] || [ "$1" = -h ] || [ "$1" = --help ]; then
    usage; return 0
  fi
  local preview=no
  if [ "$1" = preview ]; then preview=yes; shift; fi
  if [ "$1" != run ] || [ $# -ne 1 ]; then
    echo "Error: unknown command '$*'; run 'Account-Tree_install help' for the commands." >&2
    return 1
  fi
  if [ "$(id -u)" -ne 0 ]; then
    echo "Error: Account-Tree_install installs code that root runs, and must be run under root." >&2
    return 1
  fi

  local source
  source=$(source_dir) || return 1
  if [ ! -f "$source/Account-Tree_admin" ]; then
    echo "Error: $source holds no Account-Tree_admin; run this script from the consumer directory it was promoted to." >&2
    return 1
  fi
  if [ "$source" = "$INSTALL_DIR" ]; then
    echo "Error: this is the installed copy; run the Account-Tree_install in the project's consumer directory." >&2
    return 1
  fi

  local word=""
  [ "$preview" = yes ] && word="preview "
  echo "Account-Tree_install ${word}run   from $source to $INSTALL_DIR"
  install_tree "$preview" "$source" || return 1

  if [ "$preview" = yes ]; then
    "$INSTALL_DIR/Account-Tree_admin" preview system configure 2>/dev/null \
      || echo "  would run        $INSTALL_DIR/Account-Tree_admin system configure"
  else
    "$INSTALL_DIR/Account-Tree_admin" system configure
  fi
}

# run the CLI only when executed, so that another script can source the functions
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  CLI "$@"
fi
