#!/usr/bin/env python3
# -*- mode: python; coding: utf-8; python-indent-offset: 2; indent-tabs-mode: nil -*-
"""
Account-Tree_admin

The administrator's program. It runs under root, and calls the work functions
directly, so it works whether or not the Account-Tree server is running. A
person manages the child accounts of his own login account with the
Account-Tree program.

Account-Tree keeps light containers made of Linux accounts. The accounts form
a tree: root at the top, a login account for each person who logs in, and
below a login account its child accounts, which are entered from their parent
rather than through the system's login programs.

A storage is a persistent storage device: the disk the system runs from, or a
drive plugged in. Account-Tree keeps its files on a storage in one directory,
home/Account-Tree below the storage's root, which holds:
  database.sqlite3   the storage database: the storage accounts kept on this
                     storage, identified by its database uuid
  account-data       the storage accounts' homes, one directory each, side by
                     side; the '·' in an account's name places it in the tree

The system database, /var/lib/Account-Tree/system.sqlite3, is this system's own
record, identified by its system uuid. Its system map is the authority for which
storage accounts are the same accounts as system accounts here.

Usage: Account-Tree_admin <command> [argument ...]
       Account-Tree_admin preview <command> [argument ...]

Arguments:
  <dirp_storage>         the root of a storage, the directory it is mounted at:
                           /                  the disk the system runs from
                           /mnt/Hummingbird   a drive mounted at /mnt/Hummingbird
                         (dirp is short for directory path.)
  <name>                 a storage account's name, such as Thomas·Work; the
                         part before the last '·' names its parent
  <database uid>         a storage account's uid in the storage database
  <system account>       an account name in /etc/passwd on this system
  <storage account>      a storage account's name in a storage database
  <host name>            this system's host name, as hostname prints it
  <account specifier>    names an account in one place, as one of:
                           system <host name> <system account>
                           storage <dirp_storage> <storage account>
  <maximum>              a count of child accounts
  <device>               a block device, such as /dev/sdb
  <storage name>         the name a removable storage was registered under
  <key device>           a FIDO2 key's device, /dev/hidrawN
  <first system uid> <last system uid>
                         the range of system uids Account-Tree gives out

Keywords, such as make-system-account, are words given after a command's
other arguments, in any order, as the command itself is a word.

Commands:
  account make <dirp_storage> <name> [uid <database uid>] [parent <name>] [make-system-account]
                                 make a storage account, with its home in account-data;
                                 its database uid is the next counting down from
                                 1999999999, or uid keeps an existing uid. Its parent is
                                 the account its name begins with, before the last '·'.
                                 make-system-account also makes a system account of the
                                 same name on this system, with a new system uid, and
                                 records in the system map that the two are the same
                                 account, so that attach mounts its home. Without it, the
                                 storage account is used on no system until
                                 is-same-account names a system account for it
  attach <dirp_storage> [branch]
                                 make again, with the next free system uids, the system
                                 accounts storage unplug deleted; then mount the home of
                                 each storage account the system map names at
                                 /home/<system account>, nosuid and nodev. A
                                 storage that went back to an older copy, or sideways
                                 to a branch, is attached with a warning. branch first
                                 makes the storage a branch of its own, with system
                                 accounts named <system account>~<8 hex digits>, so it
                                 and the line it came from can both be attached
  detach <dirp_storage>          unmount the homes attach mounted; refused for a
                                 system account with a login session
  help | -h | --help             print this message (also printed when given no arguments)
  is-not-same-account <account specifier> <account specifier>
                                 undo is-same-account: unmount the home, delete a
                                 system account Account-Tree made, keep an adopted one,
                                 retire the system uid
  is-same-account <account specifier> <account specifier> [make-system-account]
                                 record in the system map that a system account and a
                                 storage account are the same account. The system
                                 account is adopted when it exists; make-system-account
                                 makes it, with a new system uid, when it does not
  limit set <system account> <maximum>
                                 set how many child accounts a system account may have
                                 below it; one with no limit set may have none
  preview <command>              print the log of what <command> would do, change nothing
  same-account show [storage <dirp_storage>]
                                 print which accounts are the same account here
  same-account suggest storage <dirp_storage>
                                 print is-same-account commands proposed by matching
                                 names, to read and run; changes nothing
  storage delete <dirp_storage> [delete-account-data] [forget-other-systems]
                                 undo on this system what Account-Tree did for the
                                 storage database's accounts, then delete
                                 home/Account-Tree on the storage. Every check is
                                 made first, and a failed check changes nothing. It
                                 deletes the system accounts Account-Tree made and
                                 keeps adopted ones. Homes holding files are deleted
                                 only with delete-account-data
  storage make <dirp_storage>    make home/Account-Tree on the storage, with an empty
                                 storage database and account-data
  storage plug <device> [passphrase]
                                 unlock a registered storage's partition with the key
                                 plugged in, mount it, attach it, and offer its login
                                 accounts on the login screen. Pulling the key out
                                 then unplugs it. passphrase asks for the passphrase on
                                 this terminal instead, and watches no key. Run by
                                 Account-Tree_plug@.service when the drive is plugged in
  storage plug all               plug every registered storage plugged in and locked.
                                 Run by Account-Tree_key-arrive.service when a key is
                                 plugged in
  storage register <dirp_storage> [name <storage name>]
                                 record a removable storage, while it is unlocked and
                                 mounted: its LUKS2 partition, the FIDO2 key enrolled
                                 in it, its storage database, and where it is mounted.
                                 The storage name is the mount directory's name unless
                                 given
  storage show <dirp_storage>    print the storage database, and verify it
  storage unplug <storage name or device>
                                 end every process of its accounts, whoever is at the
                                 console, and unmount their homes. Delete the system
                                 accounts Account-Tree made for them, with the files
                                 they left in /tmp, /var/tmp and /dev/shm, freeing their
                                 system uids; their passwords, shells and groups are
                                 kept in the system database for the next plug. Hide
                                 adopted ones from the login screen. Unmount and lock
                                 the storage, and power the drive off: once its light
                                 is out it is safe to pull
  storage unplug key <key device>
                                 unplug every storage the key at /dev/hidrawN unlocked.
                                 Run by Account-Tree_key@.service when the key is pulled
                                 out
  storage unregister <storage name>
                                 retire that record
  system configure               write the systemd units and udev rules that plug and
                                 unplug removable storage, and reload systemd and udev.
                                 A file of the same name that Account-Tree did not make
                                 is reported and left alone
  system delete                  delete the system database; refused while any system
                                 account is the same account as a storage account
  system make [<first system uid> <last system uid>]
                                 make the system database, with a new system uuid and
                                 the range of system uids Account-Tree gives out
                                 (default 2000 to 59999)
  system show                    print the system database, and verify it

The order on a new system: system make, storage make, account make, attach. To
undo: storage delete, then system delete.

For a removable storage, once: enroll the key with systemd-cryptenroll
--fido2-device=auto --fido2-with-client-pin=no <partition>, then system configure,
then storage register while it is mounted. From then on plugging the drive in, and
touching the key, plugs it; pulling the key out unplugs it.
"""

import sys ,os
sys.path.insert(0 ,os.path.dirname(os.path.realpath(__file__)))

import Common
import System
import Storage
import SameAccount
import StoragePlug
import SystemConfiguration
from Database import DatabaseError

# first words that take a second word to make the command
OBJECT = ("system" ,"storage" ,"account" ,"same-account" ,"limit")

# commands that only read, and so may be run by anyone with read access
READ_ONLY = ("system show" ,"storage show" ,"same-account show" ,"same-account suggest")


def print_help():
  print(__doc__.strip())
  return 0

def split_keyword(rest ,count_of__positional ,set__word=() ,set__value_word=()):
  """
  The first count_of__positional arguments are positional. Each argument after
  them is a keyword: a word from set__word, standing alone, or a word from
  set__value_word, followed by its value. Like the command itself, a keyword is
  a word and not a flag. Returns (positional ,keyword) where keyword maps each
  word given to True or to its value.
  """
  if len(rest) < count_of__positional:
    raise ValueError(f"{count_of__positional} arguments are needed before any keyword")
  positional ,tail ,keyword = rest[:count_of__positional] ,rest[count_of__positional:] ,{}
  i = 0
  while i < len(tail):
    word = tail[i]
    if word in set__word:
      keyword[word] = True; i += 1
    elif word in set__value_word:
      if i + 1 >= len(tail):
        raise ValueError(f"'{word}' needs a value after it")
      keyword[word] = tail[i + 1]; i += 2
    else:
      known = sorted(set(set__word) | set(set__value_word))
      raise ValueError(f"'{word}' is not a keyword here" + (f"; the keywords are {', '.join(known)}" if known else ""))
  return positional ,keyword

def integer(text ,what):
  try:
    return int(text)
  except ValueError:
    raise ValueError(f"{what} must be a whole number, not '{text}'")

def list__account_specifier(rest):
  """
  Parse account specifiers from rest: 'system <host name> <system account>'
  and 'storage <dirp_storage> <storage account>'.
  """
  result = []
  i = 0
  while i < len(rest):
    kind = rest[i]
    if kind not in ("system" ,"storage") or i + 2 >= len(rest):
      raise ValueError("an account specifier is 'system <host name> <system account>' or"
                       f" 'storage <dirp_storage> <storage account>', not '{' '.join(rest[i:])}'")
    if kind == "system":
      result.append({"kind": "system" ,"host": rest[i + 1] ,"account": rest[i + 2]})
    else:
      result.append({"kind": "storage" ,"dirp__storage": rest[i + 1] ,"account": rest[i + 2]})
    i += 3
  return result

def system_and_storage(list__specifier):
  """
  In 5.0, is-same-account relates a system account and a storage account,
  given in either order.
  """
  kind = sorted(s["kind"] for s in list__specifier)
  if len(list__specifier) != 2 or kind != ["storage" ,"system"]:
    raise ValueError("in 5.0 the two account specifiers are one system account and one storage account")
  system_spec = next(s for s in list__specifier if s["kind"] == "system")
  storage_spec = next(s for s in list__specifier if s["kind"] == "storage")
  return system_spec ,storage_spec

def CLI(argv=None):
  if argv is None: argv = sys.argv[1:]
  if not argv or argv[0] in ("help" ,"-h" ,"--help"): return print_help()

  preview = argv[0] == "preview"
  if preview: argv = argv[1:]
  if not argv:
    print("Error: 'preview' needs a command after it." ,file=sys.stderr)
    return 1

  command ,rest = argv[0] ,list(argv[1:])
  if command in OBJECT and rest:
    command ,rest = f"{command} {rest[0]}" ,rest[1:]

  if command not in READ_ONLY and os.geteuid() != 0 and not preview:
    print("Error: Account-Tree_admin changes the system and must be run under root." ,file=sys.stderr)
    return 1

  log = Common.Log(preview)
  try:
    # ---- read only
    if command == "system show" and not rest:
      return System.system__show()
    if command == "storage show" and len(rest) == 1:
      return Storage.storage__show(rest[0])
    if command == "same-account show" and len(rest) in (0 ,2):
      if rest and rest[0] != "storage": return usage_error(command)
      return SameAccount.same_account__show({"dirp__storage": rest[1]} if rest else None)
    if command == "same-account suggest" and len(rest) == 2 and rest[0] == "storage":
      return SameAccount.same_account__suggest({"dirp__storage": rest[1]})

    # ---- changes
    if command == "system make" and len(rest) in (0 ,2):
      if rest:
        first ,last = integer(rest[0] ,"<first system uid>") ,integer(rest[1] ,"<last system uid>")
      else:
        first ,last = System.DEFAULT__SYSTEM_UID__FIRST ,System.DEFAULT__SYSTEM_UID__LAST
      header(command ,None ,preview)
      System.system__make(first ,last ,log ,preview)
    elif command == "system delete" and not rest:
      header(command ,None ,preview)
      System.system__delete(log ,preview)
    elif command == "storage make" and len(rest) == 1:
      header(command ,rest[0] ,preview)
      Storage.storage__make(rest[0] ,log ,preview)
    elif command == "storage delete" and rest:
      (dirp__storage,) ,keyword = split_keyword(rest ,1 ,("delete-account-data" ,"forget-other-systems"))
      header(command ,dirp__storage ,preview)
      Storage.storage__delete(dirp__storage ,"delete-account-data" in keyword ,"forget-other-systems" in keyword ,log ,preview)
    elif command == "account make" and len(rest) >= 2:
      (dirp__storage ,name) ,keyword = split_keyword(rest ,2 ,("make-system-account",) ,("uid" ,"parent"))
      database_uid = integer(keyword["uid"] ,"uid") if "uid" in keyword else None
      header(command ,dirp__storage ,preview)
      Storage.account__make(dirp__storage ,name ,database_uid ,keyword.get("parent") ,"make-system-account" in keyword ,log ,preview)
    elif command == "is-same-account" and rest:
      specifier ,keyword = split_keyword(rest ,6 ,("make-system-account",))
      system_spec ,storage_spec = system_and_storage(list__account_specifier(specifier))
      header(command ,None ,preview)
      SameAccount.is__same_account(system_spec ,storage_spec ,"make-system-account" in keyword ,log ,preview)
    elif command == "is-not-same-account" and rest:
      specifier ,_ = split_keyword(rest ,6)
      system_spec ,storage_spec = system_and_storage(list__account_specifier(specifier))
      header(command ,None ,preview)
      SameAccount.is__not_same_account(system_spec ,storage_spec ,log ,preview)
    elif command == "attach" and rest:
      (dirp__storage,) ,keyword = split_keyword(rest ,1 ,("branch",))
      header(command ,dirp__storage ,preview)
      Storage.attach(dirp__storage ,"branch" in keyword ,log ,preview)
    elif command == "detach" and len(rest) == 1:
      header(command ,rest[0] ,preview)
      Storage.detach(rest[0] ,log ,preview)
    elif command == "system configure" and not rest:
      header(command ,None ,preview)
      SystemConfiguration.configure(log ,preview)
    elif command == "storage register" and rest:
      (dirp__storage,) ,keyword = split_keyword(rest ,1 ,() ,("name",))
      header(command ,dirp__storage ,preview)
      StoragePlug.register(dirp__storage ,keyword.get("name") ,log ,preview)
    elif command == "storage unregister" and len(rest) == 1:
      header(command ,None ,preview)
      StoragePlug.unregister(rest[0] ,log ,preview)
    elif command == "storage plug" and rest == ["all"]:
      header(command ,None ,preview)
      StoragePlug.plug_all(log ,preview)
    elif command == "storage plug" and rest:
      (device,) ,keyword = split_keyword(rest ,1 ,("passphrase",))
      header(command ,None ,preview)
      StoragePlug.plug(device ,"passphrase" in keyword ,log ,preview)
    elif command == "storage unplug" and len(rest) == 2 and rest[0] == "key":
      header(command ,None ,preview)
      StoragePlug.unplug_key(rest[1] ,log ,preview)
    elif command == "storage unplug" and len(rest) == 1:
      header(command ,None ,preview)
      StoragePlug.unplug(rest[0] ,log ,preview)
    elif command == "limit set" and len(rest) == 2:
      header(command ,None ,preview)
      System.limit__set(rest[0] ,integer(rest[1] ,"<maximum>") ,log ,preview)
    else:
      return usage_error(command)
  except (DatabaseError ,ValueError) as error:
    log.error(command ,str(error))
  return log.summary()

def header(command ,dirp__storage ,preview):
  where = f"   on {os.path.abspath(dirp__storage)}" if dirp__storage else ""
  print(f"Account-Tree_admin {'preview ' if preview else ''}{command}{where}")

def usage_error(command):
  print(f"Error: unknown command or wrong arguments: '{command}'." ,file=sys.stderr)
  print("Run 'Account-Tree_admin help' for the commands." ,file=sys.stderr)
  return 1


if __name__ == "__main__":
  # Under systemd, stdout is a pipe to the journal, which Python fills in
  # blocks and writes at exit, so every line got the time the run ended.
  # Line buffering writes each line as it happens, and the journal stamps it then.
  sys.stdout.reconfigure(line_buffering=True)
  try:
    sys.exit(CLI())
  except BrokenPipeError:
    # the reader of our output, such as head, closed the pipe early
    os.dup2(os.open(os.devnull ,os.O_WRONLY) ,sys.stdout.fileno())
    sys.exit(1)
